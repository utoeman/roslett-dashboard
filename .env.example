# ---------------------------------------------------------------------------
# TRD-Dashboard – Umgebungsvariablen
# Diese Datei ist die Vorlage. Kopieren nach .env und Werte eintragen.
# .env selbst wird niemals eingecheckt (siehe .gitignore).
# Der einzige Unterschied zwischen lokal und produktiv liegt in dieser Datei.
# ---------------------------------------------------------------------------

# Zugangsdaten des Postgres-Containers (nur lokal von docker-compose.yml gelesen).
# Produktiv liefert der Datenbankdienst die Werte; dort zählt allein DATABASE_URL.
POSTGRES_USER=trd
POSTGRES_PASSWORD=trd_lokal_bitte_aendern
POSTGRES_DB=trd
# Host-Port, auf dem Postgres lokal erreichbar ist. 5433 statt 5432,
# damit eine bereits laufende lokale Postgres-Installation nicht kollidiert.
POSTGRES_PORT=5433

# Vollstaendige Verbindungszeichenfolge. Wird von Drizzle (Migrationen)
# und vom Nitro-Server (Laufzeit) gelesen.
DATABASE_URL=postgresql://trd:trd_lokal_bitte_aendern@localhost:5433/trd

# Geheimnis zum Signieren der Sitzungscookies. Ab Phase 3 in Gebrauch.
# Produktiv durch einen zufaelligen Wert ersetzen: openssl rand -hex 32
SESSION_SECRET=bitte_lokal_durch_zufallswert_ersetzen

# Port, auf dem der Nuxt-Server lauscht.
PORT=3000
