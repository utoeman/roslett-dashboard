{
  "name": "roslett-dashboard",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "npm run dev --workspace @roslett/web",
    "build": "npm run build --workspace @roslett/web",
    "lint": "eslint .",
    "passwort:hash": "node scripts/passwort-hash.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && npm run typecheck --workspace @roslett/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @roslett/web",
    "db:migrate": "npm run db:migrate --workspace @roslett/web",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
