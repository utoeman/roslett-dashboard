{
  "name": "trd-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "npm run dev --workspace @trd/web",
    "build": "npm run build --workspace @trd/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && npm run typecheck --workspace @trd/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @trd/web",
    "db:migrate": "npm run db:migrate --workspace @trd/web"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
